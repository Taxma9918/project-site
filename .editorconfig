# Κοινές ρυθμίσεις για όποιον editor υποστηρίζει EditorConfig,
# ώστε τα αρχεία να μένουν συνεπή ανεξάρτητα από το εργαλείο.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Στη Markdown δύο κενά στο τέλος γραμμής σημαίνουν αλλαγή γραμμής.
trim_trailing_whitespace = false
